#!/usr/bin/env bash
# 🦀 Vérification cargo obligatoire avant chaque push (donc avant chaque PR), en local : zéro minute GitHub Actions.
# Installation, une fois par clone :  cd rust && make hooks
# Lance « make check » (formatage, clippy desktop + navigateur, tous les tests) si un fichier de rust/ a changé.
# Contourner (urgence seulement, à écrire dans la PR) :  git push --no-verify
set -euo pipefail
racine=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
rust=0
while read -r _ local_sha _ distant_sha; do
  [ "$local_sha" = "$zero" ] && continue # suppression de branche
  if [ "$distant_sha" = "$zero" ]; then
    # nouvelle branche : comparer avec main
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$distant_sha
  fi
  if [ -z "$base" ] || git diff --name-only "$base" "$local_sha" | grep -q '^rust/'; then rust=1; fi
done
if [ "$rust" = 0 ]; then
  echo "🦀 pre-push : rien de changé dans rust/, vérification cargo sautée."
  exit 0
fi
echo "🦀 pre-push : make check (formatage, clippy, tests)…"
if ! make -C "$racine/rust" check; then
  echo "❌ make check a échoué : push annulé. Corrige puis relance git push."
  exit 1
fi
echo "✅ make check OK"
