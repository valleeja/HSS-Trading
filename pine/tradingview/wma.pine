//@version=6
// Written by Argos from Jee's TradingView captures of the built-in « Moving Average Weighted » (18 Nov 2026: Length 9,
// Source close, Offset 0 hidden from the legend, a blue « WMA » line): its exact code was not received.
indicator(title="Moving Average Weighted", shorttitle="WMA", overlay=true, timeframe="", timeframe_gaps=true)
len = input.int(9, minval=1, title="Length")
src = input(close, title="Source")
offset = input.int(title="Offset", defval=0, minval=-500, maxval=500, display = display.data_window)
out = ta.wma(src, len)
plot(out, title="WMA", color=#2962FF, offset=offset)
